<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.sparkconnect</groupId>
  <artifactId>spark-connect-propagation</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>Spark Connect token and correlation-ID propagation</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <spark.version>4.1.3</spark.version>
    <scala.binary.version>2.13</scala.binary.version>
    <iceberg.version>1.11.0</iceberg.version>
    <nimbus.version>10.10</nimbus.version>
    <!-- Keep in step with OPENLINEAGE_VERSION in docker/spark/Dockerfile. -->
    <openlineage.version>1.53.0</openlineage.version>
  </properties>

  <dependencies>
    <!--
      spark-connect is where our ServerInterceptor's superinterface actually lives. The
      PUBLISHED artifact is already shaded, so this dependency supplies
      org.sparkproject.connect.grpc.* (NOT io.grpc.*) plus the unrelocated
      org.apache.spark.connect.proto.* request classes. See FINDINGS.md.
    -->
    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-connect_${scala.binary.version}</artifactId>
      <version>${spark.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-sql_${scala.binary.version}</artifactId>
      <version>${spark.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.apache.spark</groupId>
      <artifactId>spark-core_${scala.binary.version}</artifactId>
      <version>${spark.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      Compile against iceberg-core for the auth SPI. At runtime the classes come from
      iceberg-spark-runtime, which leaves org.apache.iceberg.* unrelocated (verified).
    -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-core</artifactId>
      <version>${iceberg.version}</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.17</version>
      <scope>provided</scope>
    </dependency>

    <!--
      For the OpenLineage facet that stamps our correlation ID onto lineage events. `provided`
      because the same jar is already in $SPARK_HOME/jars for the listener itself; shipping a
      second copy inside ours would give the SPI two different CustomFacetBuilder classes.
    -->
    <dependency>
      <groupId>io.openlineage</groupId>
      <artifactId>openlineage-spark_${scala.binary.version}</artifactId>
      <version>${openlineage.version}</version>
      <scope>provided</scope>
    </dependency>

    <!--
      The only dependency we actually ship. Spark bundles jjwt, not nimbus, so there is no
      version clash, but we relocate it anyway so this jar can never perturb the Spark JVM.
      HTTP is java.net.http from the JDK, so no client library is needed.
    -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>${nimbus.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.4</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>com.nimbusds:*</include>
                  <include>net.jcip:*</include>
                </includes>
              </artifactSet>
              <relocations>
                <relocation>
                  <pattern>com.nimbusds</pattern>
                  <shadedPattern>io.sparkconnect.propagation.shaded.nimbusds</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>net.jcip</pattern>
                  <shadedPattern>io.sparkconnect.propagation.shaded.jcip</shadedPattern>
                </relocation>
              </relocations>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
